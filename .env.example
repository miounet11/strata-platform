# Cluster enrichment (never commit real passwords / real IPs)
CLUSTER_HOST=
CLUSTER_SSH_USER=root
CLUSTER_SSH_PASS=
CLUSTER_TTS_URL=
CLUSTER_LUX_TTS_URL=
CLUSTER_IMAGE_MODEL=qwen-image-21

# X intake. Point at your self-hosted gateway; never commit a real key.
X_GATEWAY_URL=
X_GATEWAY_KEY=
X_BEARER_TOKEN=
# Failure alerts for the scheduled jobs (content-grow every 4h, freshness-watch, daily-guides).
# Without it those jobs still run, but a failure is only written to the local log on the host.
NOTIFY_WEBHOOK=
# Public IndexNow key. It must match apps/www/public/<key>.txt. Not a secret.
INDEXNOW_KEY=3922defa53070fe821fdf6579fe65a36

# Term radar, run by daily-guides.sh before generation. All four are optional: the defaults below
# are what the host actually runs, and none of them is needed for the radar to work.
# FEISHU_WEBHOOK_URL is the name daily-guides.sh already uses; notify.mjs accepts either that or
# NOTIFY_WEBHOOK, so an alert fires with only one of the two set.
# RADAR_ENABLED=0 turns the whole stage off (0 = off, unset = on).
# RADAR_SOURCES=huggingface,github,sitemaps — any subset.
# RADAR_SOURCE_LIMIT=40   rows fetched per source
# RADAR_MAX_ITEMS=7       new names turned into pages per run
# RADAR_MIN_SCORE=0.55    score floor
# RADAR_LOCALES=en        languages a pick is written in. Every extra locale multiplies the
#                         article count, and verify.mjs rejects near-duplicate translations.
# Production www reads this directory so pulse/releases update without a full rebuild.
STRATAT_DATA_DIR=

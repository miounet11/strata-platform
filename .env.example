# Cluster enrichment (never commit real passwords / real IPs)
CLUSTER_HOST=
CLUSTER_SSH_USER=root
CLUSTER_SSH_PASS=
CLUSTER_TTS_URL=
CLUSTER_LUX_TTS_URL=
CLUSTER_IMAGE_MODEL=qwen-image-21

# X intake. Point at your self-hosted gateway; never commit a real key.
X_GATEWAY_URL=
X_GATEWAY_KEY=
X_BEARER_TOKEN=
# Public IndexNow key. It must match apps/www/public/<key>.txt. Not a secret.
INDEXNOW_KEY=3922defa53070fe821fdf6579fe65a36
# Production www reads this directory so pulse/releases update without a full rebuild.
STRATAT_DATA_DIR=

# freshness watcher runtime files
.freshness-state.json
.freshness.lock

# Term radar: per-run output and baseline (tens of thousands of URLs), not source. Rebuilt by the
# next run, so committing them would add megabytes of churn on every job.
scripts/content/radar.json
scripts/content/radar-state.json

# Client fork build output
apps/client-upstream/host/dist
apps/client-upstream/desktop/dist

# Internal content board secret (server-only, never committed)
.dashboard-secret
apps/www/.dashboard-secret

# Site factory: its own repository (loututu114-pixel/yyds), versioned separately
.factory/
yyds-2/
.tmp-yyds/
.tmp-yyds-bot/

# A literal `~/` directory created by an unexpanded shell path. It holds ~/.clavue-secrets and
# ~/.ssh under this name, so committing it would publish credentials.
~/

# The server keeps its own patrol floor, rewritten by its own deploys (sync-and-deploy.sh
# excludes it). A workstation copy would only drift from the host it measures.
apps/www/patrol-baseline.json

# pnpm is the package manager (pnpm-lock.yaml); this file came from an accidental `npm install`.
package-lock.json

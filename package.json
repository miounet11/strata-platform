{
  "name": "stratat",
  "private": true,
  "description": "Strata.com platform — marketing site, API, and desktop launcher",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:www": "pnpm --filter @stratat/www dev",
    "dev:api": "pnpm --filter @stratat/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "node --test apps/www/tests/*.test.ts scripts/content/*.test.mjs tests/*.test.ts apps/www/src/features/tools/wp0.test.ts apps/www/src/features/tools/*/engine.test.ts",
    "check:sitemap": "pnpm --filter @stratat/www check:sitemap",
    "sync:releases": "node scripts/sync-releases.mjs",
    "sync:community": "node scripts/sync-github-community.mjs",
    "sync:creator": "node scripts/sync-creator-social.mjs",
    "sync:intelligence": "node scripts/sync-intelligence.mjs",
    "sync:downloads": "node scripts/sync-downloads.mjs",
    "sync:changelog": "node scripts/sync-changelog-rss.mjs",
    "sync:all": "pnpm sync:releases && pnpm sync:community && pnpm sync:creator && pnpm sync:intelligence && pnpm sync:downloads && pnpm sync:changelog",
    "intake:loop": "node scripts/run-intake-loop.mjs",
    "freshness:watch": "node scripts/freshness-watch.mjs",
    "content:grow": "node scripts/content-grow.mjs",
    "content:mine": "node scripts/content/mine-topics.mjs --merge",
    "content:covers": "node scripts/content/images.mjs --fallback-svg",
    "content:build-guides": "node scripts/content/generate-build-guides.mjs",
    "media:hardware": "node scripts/media/generate-hardware-visuals.mjs",
    "content:revalidate": "node scripts/revalidate.mjs --scope all",
    "enrich:assets": "node scripts/enrichment/generate-assets.mjs",
    "enrich:verify": "node scripts/enrichment/validate-images.mjs",
    "enrich:loop": "node scripts/enrichment/run-enrich-loop.mjs",
    "enrich:briefs": "node scripts/enrichment/sync-briefs-from-content.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "radar:import": "node scripts/import-radar-briefs.mjs",
    "deploy:dry": "bash deploy/sync-and-deploy.sh --dry-run",
    "deploy:sync": "bash deploy/sync-and-deploy.sh --sync-only",
    "deploy:revalidate": "bash deploy/sync-and-deploy.sh --revalidate all",
    "deploy:www": "bash deploy/sync-and-deploy.sh --deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}

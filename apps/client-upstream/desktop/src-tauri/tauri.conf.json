{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratat",
  "identifier": "com.ksxw.stratat",
  "build": {
    "frontendDist": "../../host/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI, tuned to one model.",
    "longDescription": "Stratat runs one local model, tuned to your machine. Desktop and Terminal share the same model inventory, profiles, runtime and agent sessions.",
    "resources": {
      "../../host/dist": "host/dist",
      "../../host/server": "host/server",
      "../../host/package.json": "host/package.json",
      "resources/node": "node",
      "resources/control": "control",
      "resources/harness": "harness",
      "resources/engine-bundle": "engine-bundle"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "Developer ID Application: Kunshan Xingwang Shuke Network Technology Co., Ltd. (2B7JZ4N26U)",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMjk0OTFDNzM5NTRBQUIKUldTclNwVnpIRWtwVElFSFlhZ21kVTZHT0Y5cUgzV3ozWjd1WXljc1NYLzhobWtudkhEbCtEcjIK",
      "endpoints": [
        "https://github.com/miounet11/strata-platform/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
